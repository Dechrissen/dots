[global]
    monitor = 0
    follow = none

    ### Geometry ###
    width = 380
    height = (0, 300)
    origin = bottom-right
    offset = (20, 20)
    notification_limit = 20

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 3
    progress_bar_corners = all

    ### Appearance ###
    frame_width = 1
    frame_color = "#54546d"
    gap_size = 6
    corner_radius = 4
    corners = all
    separator_height = 0
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    icon_corner_radius = 2
    icon_corners = all

    ### Text ###
    font = RobotoMono Nerd Font 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc ###
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = false

[urgency_low]
    background = "#2a2a37"
    foreground = "#727169"
    frame_color = "#363646"
    timeout = 6

[urgency_normal]
    background = "#2a2a37"
    foreground = "#dcd7ba"
    frame_color = "#7e9cd8"
    timeout = 8

[urgency_critical]
    background = "#2a2a37"
    foreground = "#dcd7ba"
    frame_color = "#e46876"
    timeout = 0
