{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": ": "
	},
	"logo": {
    "type": "small",
    "padding": {
        "top": 1,          // Top padding
        "left": 2,         // Left padding
        "right": 2         // Right padding
    }
  },
  "modules": [
    //"title",
    //"separator",
    {
      "type": "host",
      "key": "Machine",
      "format": "{vendor} {name}"
    },
    {
        "type": "os",
        "key": "OS",
        "format": "{name}"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    //"wmtheme",
    //"theme",
    //"icons",
    "font",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    {
        "type": "memory",
        "key": "Memory",
        "percent": {
            "type": 3,     // Show both percentage number and bar
            "green": 30,   // Values below 30% in green
            "yellow": 70   // 30-70% in yellow, >70% in red
        }
    },
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "break"
  ]
}
