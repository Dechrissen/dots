{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": ": "
	},
	    "logo": {
            "type": "auto",
        "padding": {
        "top": 0,          // Top padding
        "left": 1,         // Left padding
        "right": 1         // Right padding
    }
  },
  "modules": [
    //"title",
    //"separator",
    {
      "type": "host",
      "key": "Host",
      "format": "{vendor} {name}"
    },
    {
        "type": "os",
        "key": "OS",
        "format": "{name}"
    },
    "kernel",
    {
        "type": "Command",
        "key": "Install Age",
        "text": "bash -c 'installed=$(date -d \"$(awk -F\"[][]\" \"NR==1{print \\$2}\" /var/log/pacman.log)\" +%s); now=$(date +%s); diff=$((now-installed)); years=$((diff/86400/365)); months=$(((diff/86400%365)/30)); days=$((diff/86400%30)); out=\"\"; [ $years -gt 0 ] && out=\"${years} years\"; [ $months -gt 0 ] && out=\"${out:+$out, }${months} months\"; [ $days -gt 0 ] && out=\"${out:+$out, }${days} days\"; echo \"${out:-today}\"'"
    },
    "uptime",
    "packages",
    "shell",
    "de",
    "lm",
    "wm",
    //"wmtheme",
    //"theme",
    //"icons",
    "font",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    {
        "type": "memory",
        "key": "Memory",
        "percent": {
            "type": 3,     // Show both percentage number and bar
            "green": 30,   // Values below 30% in green
            "yellow": 70   // 30-70% in yellow, >70% in red
        }
    },
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "break"
  ]
}
